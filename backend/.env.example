# GCC Atlas API — environment template
# Copy to .env and fill in values. Never commit the real .env file.

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database
# SQLite file path (file is created automatically). Use ':memory:' for tests.
DB_PATH=./data/gcc-atlas.db

# AI provider (OPTIONAL). All AI calls happen server-side only.
# If AI_API_KEY is empty, the assistant runs in explicitly-labelled
# deterministic demo mode backed by the local dataset.
AI_API_KEY=
# OpenAI-compatible endpoint (adjust for other providers):
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# GCC Atlas API — environment template
# Copy to .env and fill in values. Never commit the real .env file.

# Server
# NODE_ENV: development | test | production
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database
# SQLite file path (file is created automatically). Use ':memory:' for tests.
DB_PATH=./data/gcc-atlas.db

# AI provider (OPTIONAL). All AI calls happen server-side only — the key is
# never sent to the browser. If AI_API_KEY is empty, the assistant runs in
# explicitly-labelled deterministic demo mode backed by the local dataset
# (demo answers are composed from retrieved records; nothing is invented).
AI_API_KEY=
# OpenAI-compatible endpoint (adjust for other providers):
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Provider call hard limits (Phase 7):
AI_TIMEOUT_MS=30000        # abort the provider call after this many ms
AI_MAX_TOKENS=800          # cap on model answer tokens (clamped 200–1000)

# Rate limiting (Phase 6; memory store — swap a shared store before scaling out)
RATE_LIMIT_WINDOW_MS=900000    # 15 minutes
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_ANALYSIS_MAX=40     # /assistant/*, /cities/compare, /dashboard/*, /events/summary
RATE_LIMIT_WRITES_MAX=60       # /saved-research, /saved-comparisons, /events

# GCC Atlas — root environment template
# The backend reads these from backend/.env (copy backend/.env.example there).
# The frontend only needs VITE_API_BASE_URL (optional; defaults to /api proxy).
# This root file exists so one template is visible at the repo root.
# NEVER commit real .env files or API keys.

# ---- Backend (backend/.env) ----
NODE_ENV=development
PORT=4000
DB_PATH=./data/gcc-atlas.db
CORS_ORIGIN=http://localhost:5173

# AI provider (OPTIONAL). Empty AI_API_KEY = deterministic demo mode.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---- Frontend (frontend/.env) ----
# Leave unset in dev to use the Vite /api proxy to http://localhost:4000.
# VITE_API_BASE_URL=http://localhost:4000/api
